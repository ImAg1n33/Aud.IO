# Runtime data directory — where episodes.db, chroma_episodes/, profiles/ live
# Default: backend/data/ (relative to the backend package)
# AUD_IO_DATA_DIR=/path/to/custom/data

# Generic LLM config (recommended)
# Use one unified format so different providers can be swapped easily.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=your_llm_api_key_here

# CORS allowlist (comma-separated). Example:
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional memory update model (used by MemoryManager)
MEMORY_BASE_URL=
MEMORY_MODEL=deepseek-v4-pro
MEMORY_API_KEY=

# Provider-specific optional keys (fallback when LLM_API_KEY is empty)
# Only OpenAI-compatible providers are supported (/chat/completions endpoint).
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Provider-specific optional models
OPENAI_MODEL=gpt-4o-mini

# Optional external APIs
NETEASE_API_BASE_URL=
NETEASE_COOKIE=

# Weather city for environment-aware DJ (RFC-005)
# Leave empty for IP-based auto-detection via wttr.in
WEATHER_CITY=

# MCP Servers (JSON array, optional — leave empty to use only built-in tools)
# Each entry: {"name":"...", "transport":"stdio", "command":"...", "args":[...], "env":{...}}
# Example:
# MCP_SERVERS='[
#   {"name":"weather","transport":"stdio","command":"npx","args":["-y","@anthropic/mcp-server-weather"]},
#   {"name":"tts","transport":"stdio","command":"uvx","args":["fish-audio-mcp"]}
# ]'
MCP_SERVERS=[]
