# Generic LLM config (recommended)
# Use one unified format so different providers can be swapped easily.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=your_llm_api_key_here

# Provider-specific optional keys (fallback when LLM_API_KEY is empty)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Provider-specific optional models
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional external APIs
NETEASE_API_BASE_URL=
WEATHER_API_KEY=
TTS_API_KEY=
FISH_AUDIO_API_KEY=
